{
  "name": "auto-jira-agent-root",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "install:all": "node scripts/setup.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "agent": "node scripts/run-agent.js",
    "dev": "concurrently -n \"SERVER,CLIENT,AGENT\" -c \"blue,cyan,green\" \"npm run server\" \"npm run client\" \"npm run agent\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
